## Patterns to Mirror

**VITE_7_CONFIGURATION:**
```javascript
// SOURCE: Context7 /vitejs/vite research
// COPY THIS PATTERN:
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'

export default defineConfig({
  plugins: [react()],
  resolve: {
    alias: {
      '@': path.resolve(__dirname, './src'),
    }
  },
  server: {
    port: 3000,
    host: '0.0.0.0',
    hmr: { overlay: true }
  },
  build: {
    target: 'baseline-widely-available', // Vite 7 default
    chunkSizeWarningLimit: 1000,
    reportCompressedSize: false, // Faster builds
    minify: 'terser',
    terserOptions: {
      compress: { drop_console: true }
    }
  }
})
```

**MOTION_VIEWPORT_ANIMATIONS:**
```jsx
// SOURCE: Context7 /websites/motion_dev_react research  
// COPY THIS PATTERN:
import { motion } from 'motion/react'

const Section = ({ children }) => (
  <motion.section
    initial={{ opacity: 0, y: 50 }}
    whileInView={{ opacity: 1, y: 0 }}
    viewport={{ once: true, amount: 0.3 }}
    transition={{ duration: 0.6, ease: "easeOut" }}
  >
    {children}
  </motion.section>
)

// List animations with stagger
const list = {
  visible: { opacity: 1, transition: { staggerChildren: 0.1 } },
  hidden: { opacity: 0 }
}

const item = {
  visible: { opacity: 1, x: 0 },
  hidden: { opacity: 0, x: -50 }
}
```

**TAILWIND_DESIGN_SYSTEM:**
```css
/* SOURCE: Context7 /websites/v3_tailwindcss research */
/* COPY THIS PATTERN: */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --color-primary: 220 100% 50%;
    --color-secondary: 280 100% 60%;
    --color-accent: 45 100% 55%;
  }
}

@layer components {
  .section-container {
    @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
  }
  
  .hero-gradient {
    @apply bg-gradient-to-br from-blue-600 via-purple-600 to-pink-600;
  }
}
```

**COMPONENT_ARCHITECTURE:**
```jsx
// SOURCE: PRD requirements + React best practices
// COPY THIS PATTERN:
const HeroSection = () => (
  <motion.section 
    className="min-h-screen flex items-center justify-center hero-gradient"
    initial={{ opacity: 0 }}
    animate={{ opacity: 1 }}
    transition={{ duration: 1 }}
  >
    <div className="section-container text-center text-white">
      <motion.h1 
        className="text-6xl font-bold mb-6"
        initial={{ y: 30, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        transition={{ delay: 0.2 }}
      >
        AI-Powered Development That Actually Works
      </motion.h1>
    </div>
  </motion.section>
)
```

